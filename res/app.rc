#include <windows.h>
#include "../src/resource.h"

IDI_APP ICON "app.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

IDR_BACKGROUND PACKAGE "background.png"
IDR_CATALOG    PACKAGE "catalog.txt"
#ifdef ISODECK_HAVE_VENTOY
IDR_VENTOY_ZIP PACKAGE "../third_party/ventoy.zip"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "FLOW POINT"
            VALUE "FileDescription", "IsoDeck - Multiboot USB creator"
            VALUE "FileVersion", ISODECK_VERSION
            VALUE "InternalName", "IsoDeck"
            VALUE "LegalCopyright", "FLOW POINT. Boot engine: Ventoy (GPLv3)"
            VALUE "OriginalFilename", "IsoDeck.exe"
            VALUE "ProductName", "IsoDeck"
            VALUE "ProductVersion", ISODECK_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
